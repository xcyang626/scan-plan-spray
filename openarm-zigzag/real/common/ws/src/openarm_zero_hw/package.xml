<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarm_zero_hw</name>
  <version>0.1.0</version>
  <description>OpenArm hardware interface with zero-calibration offsets and
    safe lock-on-activate behavior (derived from openarm_hardware)</description>
  <maintainer email="dev@example.com">local</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>hardware_interface</depend>
  <depend>openarm_can</depend>
  <depend>pluginlib</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
